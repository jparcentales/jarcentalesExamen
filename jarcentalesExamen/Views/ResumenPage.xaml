<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="jarcentalesExamen.Views.ResumenPage"
             Title="RESUMEN">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Label x:Name="UsuarioConectadoLabel"
                   Text="Usuario conectado:"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Label Text="RESUMEN"
                   Style="{StaticResource PageTitleStyle}" />

            <Grid ColumnDefinitions="Auto,*"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                  ColumnSpacing="14"
                  RowSpacing="10">
                <Label Grid.Row="0" Grid.Column="0" Text="Nombre:" FontAttributes="Bold" />
                <Label x:Name="NombreLabel" Grid.Row="0" Grid.Column="1" />

                <Label Grid.Row="1" Grid.Column="0" Text="Apellido:" FontAttributes="Bold" />
                <Label x:Name="ApellidoLabel" Grid.Row="1" Grid.Column="1" />

                <Label Grid.Row="2" Grid.Column="0" Text="Edad:" FontAttributes="Bold" />
                <Label x:Name="EdadLabel" Grid.Row="2" Grid.Column="1" />

                <Label Grid.Row="3" Grid.Column="0" Text="Fecha:" FontAttributes="Bold" />
                <Label x:Name="FechaLabel" Grid.Row="3" Grid.Column="1" />

                <Label Grid.Row="4" Grid.Column="0" Text="Ciudad:" FontAttributes="Bold" />
                <Label x:Name="CiudadLabel" Grid.Row="4" Grid.Column="1" />

                <Label Grid.Row="5" Grid.Column="0" Text="País:" FontAttributes="Bold" />
                <Label x:Name="PaisLabel" Grid.Row="5" Grid.Column="1" />

                <Label Grid.Row="6" Grid.Column="0" Text="Monto Inicial:" FontAttributes="Bold" />
                <Label x:Name="MontoInicialLabel" Grid.Row="6" Grid.Column="1" />

                <Label Grid.Row="7" Grid.Column="0" Text="Pago mensual:" FontAttributes="Bold" />
                <Label x:Name="PagoMensualLabel" Grid.Row="7" Grid.Column="1" />

                <Label Grid.Row="8" Grid.Column="0" Text="Pago Total:" FontAttributes="Bold" />
                <Label x:Name="PagoTotalLabel" Grid.Row="8" Grid.Column="1" FontAttributes="Bold" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
